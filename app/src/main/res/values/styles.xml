<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="AppTheme.Base" />

    <!-- Timepage Typography System (PRD Specifications) -->
    
    <!-- H1 Titles (Day/View Name): 30sp, Semi-Bold -->
    <style name="TextAppearance.Timepage.H1">
        <item name="android:textSize">@dimen/text_h1_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dark_text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    
    <!-- H2 Titles (Section Headers "Today"): 24sp, Semi-Bold -->
    <style name="TextAppearance.Timepage.H2">
        <item name="android:textSize">@dimen/text_h2_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dark_text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    
    <!-- Date Headers: 14sp, Medium, Uppercase -->
    <style name="TextAppearance.Timepage.DateHeader">
        <item name="android:textSize">@dimen/text_date_header</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dark_text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
    
    <!-- Event Titles: 17sp, Medium -->
    <style name="TextAppearance.Timepage.EventTitle">
        <item name="android:textSize">@dimen/text_event_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dark_text_primary</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
    
    <!-- Event Details (Time/Location): 13sp, Regular -->
    <style name="TextAppearance.Timepage.EventDetails">
        <item name="android:textSize">@dimen/text_event_details</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/dark_text_secondary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    
    <!-- Button Text: 15sp, Medium, Uppercase -->
    <style name="TextAppearance.Timepage.Button">
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
    
    <!-- Body/Notes: 15sp, Regular -->
    <style name="TextAppearance.Timepage.Body">
        <item name="android:textSize">@dimen/text_body_notes</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/dark_text_primary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- Timepage Component Styles -->
    
    <!-- Event Card Style -->
    <style name="EventCard.Timepage">
        <item name="cardCornerRadius">@dimen/card_corner_radius_timepage</item>
        <item name="cardBackgroundColor">@color/dark_content_background</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="contentPadding">@dimen/event_card_padding</item>
        <item name="android:layout_marginStart">@dimen/event_card_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/event_card_margin_horizontal</item>
        <item name="android:layout_marginTop">@dimen/event_card_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/event_card_margin_vertical</item>
    </style>
    
    <!-- Primary Button Style -->
    <style name="Button.Timepage.Primary">
        <item name="android:background">@drawable/button_primary_timepage</item>
        <item name="android:textAppearance">@style/TextAppearance.Timepage.Button</item>
        <item name="android:textColor">@color/dark_primary_background</item>
        <item name="android:backgroundTint">@color/accent_primary</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    
    <!-- Secondary Button Style -->
    <style name="Button.Timepage.Secondary">
        <item name="android:background">@drawable/button_secondary_timepage</item>
        <item name="android:textAppearance">@style/TextAppearance.Timepage.Button</item>
        <item name="android:textColor">@color/accent_primary</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    
    <!-- App Bar Style -->
    <style name="AppBar.Timepage">
        <item name="android:background">@color/dark_primary_background</item>
        <item name="android:elevation">0dp</item>
        <item name="android:paddingStart">@dimen/app_bar_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/app_bar_padding_horizontal</item>
        <item name="android:minHeight">@dimen/app_bar_height</item>
    </style>
    
    <!-- Timeline Hour Style -->
    <style name="TimelineHour.Timepage">
        <item name="android:textAppearance">@style/TextAppearance.Timepage.EventDetails</item>
        <item name="android:textColor">@color/dark_text_secondary</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:paddingEnd">@dimen/spacing_standard</item>
        <item name="android:layout_width">@dimen/timeline_time_width</item>
        <item name="android:layout_height">@dimen/timeline_hour_height</item>
    </style>

    <!-- Enhanced Legacy Styles for Compatibility -->
    <style name="DayView">
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/text_event_details</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/dark_text_primary</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:minWidth">@dimen/touch_target_minimum</item>
        <item name="android:minHeight">@dimen/touch_target_minimum</item>
    </style>

    <style name="DayView.Today">
        <item name="android:background">@drawable/today_background_timepage</item>
        <item name="android:textColor">@color/dark_primary_background</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="DayView.Selected">
        <item name="android:background">@drawable/selected_day_background_timepage</item>
        <item name="android:textColor">@color/accent_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MetaView" parent="DayView">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_date_header</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dark_text_secondary</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="WeekNumberStyle">
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">top|center_horizontal</item>
        <item name="android:textSize">@dimen/text_event_details</item>
        <item name="android:textColor">@color/dark_text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:padding">@dimen/spacing_half</item>
    </style>

    <style name="ArrowStyle">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:minWidth">@dimen/touch_target_minimum</item>
        <item name="android:minHeight">@dimen/touch_target_minimum</item>
        <item name="android:tint">@color/dark_text_secondary</item>
    </style>

    <style name="MonthStyle">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:minHeight">@dimen/touch_target_minimum</item>
    </style>

    <style name="DatePickerLightStyle">
        <item name="android:textColorPrimary">@color/theme_light_text_color</item>
    </style>

    <style name="DatePickerDarkStyle">
        <item name="android:textColorPrimary">@color/theme_dark_text_color</item>
    </style>
</resources>
