<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_xlarge">

    <!-- Day Header -->
    <LinearLayout
        android:id="@+id/day_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin_default"
        android:layout_marginEnd="@dimen/screen_margin_default"
        android:layout_marginBottom="@dimen/spacing_standard"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/spacing_half">

        <!-- Day Number and Name Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Day Name (SUN, MON, etc.) -->
            <org.fossify.commons.views.MyTextView
                android:id="@+id/day_name"
                style="@style/TextAppearance.Timepage.DateHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_text_secondary"
                android:textSize="12sp"
                tools:text="TUE" />

            <!-- Day Number -->
            <org.fossify.commons.views.MyTextView
                android:id="@+id/day_number"
                style="@style/TextAppearance.Timepage.H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_text_primary"
                android:textSize="20sp"
                tools:text="24" />

        </LinearLayout>

        <!-- Today Indicator Background -->
        <View
            android:id="@+id/today_indicator_background"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-8dp"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-8dp"
            android:layout_marginBottom="-8dp"
            android:background="@drawable/today_background_timepage"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Event Count Indicator (optional) -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/day_event_count"
            style="@style/TextAppearance.Timepage.EventDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_standard"
            android:background="@drawable/event_count_background"
            android:paddingStart="@dimen/spacing_standard"
            android:paddingTop="@dimen/spacing_half"
            android:paddingEnd="@dimen/spacing_standard"
            android:paddingBottom="@dimen/spacing_half"
            android:textColor="@color/dark_text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="3"
            tools:visibility="visible" />

        <!-- Expand/Collapse Icon -->
        <ImageView
            android:id="@+id/day_expand_icon"
            android:layout_width="@dimen/icon_size_standard"
            android:layout_height="@dimen/icon_size_standard"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/expand"
            android:padding="@dimen/spacing_half"
            android:src="@drawable/ic_expand_less_vector"
            android:tint="@color/dark_text_secondary"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Day Events Container -->
    <LinearLayout
        android:id="@+id/day_events_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- All Day Events Section (if any) -->
        <LinearLayout
            android:id="@+id/day_all_day_events"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- All day events will be added here -->

        </LinearLayout>

        <!-- Timed Events Section -->
        <LinearLayout
            android:id="@+id/day_timed_events"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Timed events will be added here -->

        </LinearLayout>

        <!-- Empty Day Placeholder -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/day_empty_placeholder"
            style="@style/TextAppearance.Timepage.EventDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin_default"
            android:layout_marginEnd="@dimen/screen_margin_default"
            android:layout_marginBottom="@dimen/spacing_standard"
            android:alpha="0.6"
            android:gravity="center"
            android:padding="@dimen/spacing_large"
            android:text="@string/no_events"
            android:textStyle="italic"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout> 