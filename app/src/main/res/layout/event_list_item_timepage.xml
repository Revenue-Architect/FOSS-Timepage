<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/EventCard.Timepage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/event_card_padding">

        <!-- Event color indicator dot -->
        <View
            android:id="@+id/event_color_indicator"
            android:layout_width="@dimen/event_dot_size"
            android:layout_height="@dimen/event_dot_size"
            android:layout_marginTop="@dimen/spacing_half"
            android:background="@drawable/event_color_dot"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/event_title" />

        <!-- Event title -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/event_title"
            style="@style/TextAppearance.Timepage.EventTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/event_dot_margin_end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/event_color_indicator"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Meeting with Sam" />

        <!-- Event time and location -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/event_time"
            style="@style/TextAppearance.Timepage.EventDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/event_dot_margin_end"
            android:layout_marginTop="@dimen/spacing_half"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/event_color_indicator"
            app:layout_constraintTop_toBottomOf="@id/event_title"
            tools:text="1:00 PM - 2:00 PM" />

        <!-- Event location (optional) -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/event_location"
            style="@style/TextAppearance.Timepage.EventDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/event_dot_margin_end"
            android:layout_marginTop="@dimen/spacing_half"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/event_color_indicator"
            app:layout_constraintTop_toBottomOf="@id/event_time"
            tools:text="Conference Room A"
            tools:visibility="visible" />

        <!-- All day event indicator -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/event_all_day"
            style="@style/TextAppearance.Timepage.EventDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/event_dot_margin_end"
            android:layout_marginTop="@dimen/spacing_half"
            android:background="@drawable/all_day_indicator_background"
            android:paddingStart="@dimen/spacing_standard"
            android:paddingTop="@dimen/spacing_half"
            android:paddingEnd="@dimen/spacing_standard"
            android:paddingBottom="@dimen/spacing_half"
            android:text="@string/all_day"
            android:textColor="@color/dark_text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/event_color_indicator"
            app:layout_constraintTop_toBottomOf="@id/event_title"
            tools:visibility="visible" />

        <!-- Repeat indicator -->
        <ImageView
            android:id="@+id/event_repeat_icon"
            android:layout_width="@dimen/icon_size_standard"
            android:layout_height="@dimen/icon_size_standard"
            android:layout_marginEnd="@dimen/spacing_standard"
            android:contentDescription="@string/repeat"
            android:src="@drawable/ic_repeat_vector"
            android:tint="@color/dark_text_secondary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/event_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/event_title"
            tools:visibility="visible" />

        <!-- Task completion indicator -->
        <CheckBox
            android:id="@+id/event_task_completion"
            android:layout_width="@dimen/icon_size_standard"
            android:layout_height="@dimen/icon_size_standard"
            android:layout_marginEnd="@dimen/spacing_standard"
            android:background="@drawable/task_checkbox_background"
            android:buttonTint="@color/accent_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/event_title"
            app:layout_constraintEnd_toStartOf="@id/event_repeat_icon"
            app:layout_constraintTop_toTopOf="@id/event_title"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView> 