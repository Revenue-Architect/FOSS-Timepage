<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_margin_default"
    android:layout_marginEnd="@dimen/screen_margin_default"
    android:layout_marginBottom="@dimen/spacing_standard"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_standard">

    <!-- Setting Icon -->
    <ImageView
        android:id="@+id/setting_icon"
        android:layout_width="@dimen/icon_size_standard"
        android:layout_height="@dimen/icon_size_standard"
        android:layout_marginEnd="@dimen/spacing_large"
        android:src="@drawable/ic_notification_vector"
        android:tint="@color/dark_text_secondary"
        tools:src="@drawable/ic_notification_vector" />

    <!-- Setting Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Setting Title -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/setting_title"
            style="@style/TextAppearance.Timepage.EventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Notifications" />

        <!-- Setting Value -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/setting_value"
            style="@style/TextAppearance.Timepage.EventDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_half"
            tools:text="Never" />

    </LinearLayout>

    <!-- Dropdown Arrow -->
    <ImageView
        android:id="@+id/dropdown_arrow"
        android:layout_width="@dimen/icon_size_standard"
        android:layout_height="@dimen/icon_size_standard"
        android:layout_marginStart="@dimen/spacing_standard"
        android:src="@drawable/ic_expand_more_vector"
        android:tint="@color/dark_text_secondary" />

</LinearLayout> 